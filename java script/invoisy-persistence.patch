+let busy = false;
+async function guard(task) {
+  if (busy) return;
+  busy = true;
+  try {
+    await task();
+  } catch (e) {
+    notify("Something went wrong. " + errorText(e), "error");
+  } finally {
+    busy = false;
+  }
+}
+
+function savedNote(result) {
+  return result.toFile ? "" : " Saved in this browser only.";
