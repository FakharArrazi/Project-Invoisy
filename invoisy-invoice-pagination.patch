+def rows_whole(pages):
+    """On every page the products and their type lines match up: no row is cut in two."""
+    for p in pages:
+        rows = len(re.findall(r"^P\d{3}\b", p["text"], re.M))
+        types = len(re.findall(r"\b(?:Faience|Porcelain)\b", p["text"]))
+        if rows != types:
