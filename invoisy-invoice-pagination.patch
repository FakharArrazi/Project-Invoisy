+    return [[int(n) for n in re.findall(r"^P(\d{3})\b", p["text"], re.M)] for p in pages]
+
+def every_product_once(pages, n):
+    flat = [x for page in product_numbers(pages) for x in page]
+    return flat == list(range(1, n + 1))
