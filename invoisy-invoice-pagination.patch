+                dy = min(a["bottom"], b["bottom"]) - max(a["top"], b["top"])
+                if dx > 1 and dy > 1:
+                    area = dx * dy
+                    small = min((a["x1"] - a["x0"]) * (a["bottom"] - a["top"]), (b["x1"] - b["x0"]) * (b["bottom"] - b["top"]))
