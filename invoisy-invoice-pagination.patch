+def headings_repeat(pages):
+    """Every page that carries products repeats the column headings."""
+    for p in pages:
+        if re.search(r"^P\d{3}\b", p["text"], re.M):
+            if not all(h in p["text"] for h in ("Product", "Qty", "Price (DA)", "Total (DA)")):
