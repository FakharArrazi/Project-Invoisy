+    pdf = print_invoice(page, "10-delivery", {"items": 16, "payments": 2, "deliveries": [1] * 30})
+    check(len(pdf) >= 2 and every_product_once(pdf, 16) and numbering_ok(pdf) and inside_margins(pdf) and no_overlap(pdf) and "DELIVERY HISTORY" in " ".join(p["text"] for p in pdf),
+          "10. delivery history flows with its status label (%d pages)" % len(pdf))
+    pdf = print_invoice(page, "10-second-customer", {"items": 28, "payments": 1, "secondCustomer": "Builder Co"})
+    check(continuation_ok(pdf, customer="Yacine Benali / Builder Co"), "10. continuation header names both customers")
+    page.evaluate("l => { state.settings.logo = l; }", LOGO)
+    page.evaluate("() => { state.previewInvoice = null; }")
+    spec = {"items": 14, "payments": 1}
+    page.evaluate(BUILD_JS, spec)
+    page.evaluate("l => { state.settings.logo = l; renderInvoice(); }", LOGO)
+    path = OUT / "10-logo.pdf"
+    page.pdf(path=str(path), prefer_css_page_size=True, print_background=True)
+    pdf = read_pdf(path)
+    check(summary_together(pdf) and every_product_once(pdf, 14) and inside_margins(pdf) and content_clear_of_footer(pdf), "10. invoice with a logo (%d pages)" % len(pdf))
+
+    # Stale pages: changing the previewed invoice must not leave old pages behind.
+    stale = page.evaluate("() => { renderInvoice(); return [document.getElementById('invoicePages').children.length, document.documentElement.dataset.invoicePages || '']; }")
+    check(stale == [0, ""], "no printed pages are left behind once the preview is drawn again")
+
+    # The screen: the invoice preview is the same as before and the built pages never show.
+    page.evaluate(BUILD_JS, {"items": 30, "payments": 2})
+    shown = page.evaluate("() => getComputedStyle(document.getElementById('invoicePages')).display")
+    check(shown == "none", "the printed pages are not visible on screen")
+    check(page.locator("#invoice .inv-summary .inv-status").count() == 1 and page.locator("#invoice .inv-table tbody tr").count() == 30, "the preview still shows the whole invoice, with the status inside the summary")
+
+    # Other printed documents are untouched: the collection document printed right after an invoice (whose pages are still built)
+    # is that document alone, with no invoice pages, continuation headers or page numbers.
+    print_invoice(page, "12-before-collection", {"items": 30, "payments": 2, "deliveries": [1, 1]})
+    built = page.evaluate("() => document.getElementById('invoicePages').children.length")
+    page.evaluate("() => { const inv = state.invoices[0]; document.getElementById('collectionPrint').innerHTML = collectionHtml(inv); document.body.dataset.printing = 'collection'; }")
+    path = OUT / "12-collection.pdf"
+    page.pdf(path=str(path), prefer_css_page_size=True, print_background=True)
+    page.evaluate("() => { delete document.body.dataset.printing; }")
+    pdf = read_pdf(path)
+    alltext = " ".join(p["text"] for p in pdf)
+    check(built >= 2 and "COL-000018" in alltext and "STATUS:" not in alltext and "Page 1 of" not in alltext and "INVOICE — CONTINUED" not in alltext,
+          "the collection document prints alone, even right after an invoice was printed (%d pages built before)" % built)
+
+    # The fall-back: if pages can not be built the browser prints the preview as before.
+    page.evaluate("() => { window.__real = InvoicePrint.paginate; InvoicePrint.paginate = () => { throw new Error('boom'); }; }")
+    page.evaluate(BUILD_JS, {"items": 5, "payments": 1})
+    path = OUT / "11-fallback.pdf"
+    page.pdf(path=str(path), prefer_css_page_size=True, print_background=True)
+    pdf = read_pdf(path)
+    check(len(pdf) == 1 and "STATUS:" in pdf[0]["text"] and "Page 1 of" not in pdf[0]["text"], "if laying out the pages fails, the invoice still prints the old way")
+    page.evaluate("() => { InvoicePrint.paginate = window.__real; }")
+
+    check(not errors, "no console errors: %s" % errors[:3])
+    browser.close()
+
+print()
+print("FAILED: %d" % len(problems) if problems else "All checks passed.")
+sys.exit(1 if problems else 0)
diff --git a/tests/invoice-print-markup.test.js b/tests/invoice-print-markup.test.js
new file mode 100644
index 0000000..8027c5b
--- /dev/null
+++ b/tests/invoice-print-markup.test.js
@@ -0,0 +1,122 @@
+"use strict";
+
+// What the printed invoice is made of: the financial summary is one block (totals AND payment status), the product rows,
+// payment entries and deliveries are separate entries that can be laid out one by one, and the continuation header is built from
+// the invoice's own data. The page layout itself is tested in invoice-print.test.js and, in a real browser, in tests/e2e.
+const assert = require("node:assert/strict");
+const test = require("node:test");
+const { loadProductApi } = require("./helpers");
+
+function item(n, extra) {
+  return { lineId: "l" + n, productId: "p" + n, name: "Tile " + n, manufacturer: "Garnada", tileSize: "60*120", coveragePerBox: 2.88, sellingUnit: "box", sku: "S" + n,
+    qty: n, unitPrice: 1000, total: n * 1000, priceUnit: "box", productPrice: 1000, productType: "Faience", ...extra };
+}
+
+function invoice(overrides = {}) {
+  const items = overrides.items || [item(1), item(2), item(3)];
+  const subtotal = items.reduce((s, i) => s + i.total, 0);
+  return {
+    id: "i-1", invoiceNumber: "INV-000042", date: "2026-10-17T13:32:00.000Z", customer: { name: "Amine Rahmani", phone: "0555", address: "" },
+    items, subtotal, discount: 100, tax: 0, total: subtotal - 100, payments: [], discountPercent: null, taxPercent: null, currency: "DA",
+    business: { name: "Zenith Carrelage", address: "", phone: "", email: "" }, ...overrides,
+  };
+}
+
+function load(language) {
+  const { api } = loadProductApi();
+  api.applyData({ products: [], invoices: [], settings: { ...api.DEFAULT_SETTINGS, language: language || "en" }, counter: 0, lastSaved: "" });
+  return api;
+}
+
+const count = (text, re) => (text.match(re) || []).length;
+
+test("the payment status is inside the financial summary block, whatever the payment state", () => {
+  const api = load();
+  for (const [payments, status] of [[[], "UNPAID"], [[{ amount: 500, timestamp: "2026-10-17T14:00:00.000Z" }], "PARTIALLY PAID"], [[{ amount: 5900, timestamp: "2026-10-17T14:00:00.000Z" }], "PAID"]]) {
+    const parts = api.invoiceParts(invoice({ payments }));
+    assert.match(parts.summary, /^<div class="inv-summary">/);
+    for (const label of ["Subtotal", "Discount", "Tax", "TOTAL", "Total Paid", "Remaining"]) assert.ok(parts.summary.includes(label), `${status}: ${label} is in the summary`);
+    assert.ok(parts.summary.includes("STATUS: " + status), `${status}: the status is in the summary`);
+    assert.ok(parts.summary.indexOf("inv-totals") < parts.summary.indexOf("inv-status"), "the status follows the totals");
+    assert.equal(count(parts.payments ? parts.payments.entries.join("") : "", /STATUS/g), 0, "the payment history does not carry the status");
+  }
+});
+
+test("the screen preview shows the same invoice as before, in the same order", () => {
+  const api = load();
+  const inv = invoice({ payments: [{ amount: 500, timestamp: "2026-10-17T14:00:00.000Z" }, { amount: 300, timestamp: "2026-10-18T14:00:00.000Z" }] });
+  const html = api.invoiceHtml(inv);
+  const order = ["inv-head", "inv-meta", "inv-table", "inv-summary", "inv-totals", "inv-status", "inv-payments", "inv-thanks"].map((c) => html.indexOf(c));
+  assert.ok(order.every((n) => n >= 0), "every part is there");
+  assert.deepEqual(order, order.slice().sort((a, b) => a - b), "head, customer, products, totals, status, payment history, thank-you");
+  assert.equal(count(html, /<tr><td>Tile \d/g), 3, "three product rows");
+  assert.equal(count(html, /class="inv-pay"/g), 2, "two payments");
+  for (const figure of ["6,000 DA", "100 DA", "5,900 DA", "800 DA", "5,100 DA"]) assert.ok(html.includes(figure), figure);
+});
+
+test("an invoice with no payments keeps the existing empty message as a single entry", () => {
+  const api = load();
+  const parts = api.invoiceParts(invoice());
+  assert.equal(parts.payments.entries.length, 1);
+  assert.match(parts.payments.entries[0], /No payments yet\./);
+  assert.match(api.invoiceHtml(invoice()), /PAYMENT HISTORY<\/h3>/);
+});
+
+test("print items: every product, payment and delivery is its own entry, and the summary is a single block", () => {
+  const api = load();
+  const items = Array.from({ length: 25 }, (_, i) => item(i + 1));
+  const payments = Array.from({ length: 12 }, (_, i) => ({ amount: 100 + i, timestamp: new Date(Date.UTC(2026, 9, 1 + i, 9)).toISOString() }));
+  const list = api.printItems(invoice({ items, payments }));
+  const kinds = [...list.map((x) => x.kind)];   // copied: the app runs in its own vm realm
+  assert.deepEqual(kinds, ["block", "flow", "block", "flow", "block"], "header, product rows, summary, payment history, thank-you");
+  assert.equal(list[1].entries.length, 25);
+  assert.equal(list[3].entries.length, 12);
+  assert.ok(list[2].html.includes("STATUS:") && list[2].html.includes("Remaining"), "the summary block holds the totals and the status");
+  assert.match(list[4].html, /Thank you for your purchase\./);
+  assert.ok(list[1].entries.every((row) => /^<tr>/.test(row)), "one table row per product");
+  // a piece of the product table always carries the column headings
+  assert.match(list[1].build(list[1].entries.slice(5, 7), true), /<thead>.*<th>Product<\/th>.*<tbody><tr>.*<\/tr><tr>.*<\/tr><\/tbody>/s);
+  // a piece of the history that continues says so; the first one does not
+  assert.match(list[3].build(list[3].entries.slice(0, 1), false), /<h3>PAYMENT HISTORY<\/h3>/);
+  assert.match(list[3].build(list[3].entries.slice(4, 6), true), /<h3>PAYMENT HISTORY \(continued\)<\/h3>/);
+});
+
+test("carried-forward debt stays its own block between the products and the summary", () => {
+  const api = load();
+  const inv = invoice({ carriedForward: [{ transferId: "t-1", sourceInvoiceId: "i-0", sourceInvoiceNumber: "INV-000007", sourceDate: "2026-09-01T10:00:00.000Z", amount: 700 }] });
+  const list = api.printItems(inv);
+  const blocks = list.filter((x) => x.kind === "block").map((x) => x.html);
+  assert.ok(blocks.some((h) => /inv-carried/.test(h) && !/inv-summary/.test(h)), "its own block");
+  assert.ok(list.findIndex((x) => /inv-carried/.test(x.html || "")) < list.findIndex((x) => /inv-summary/.test(x.html || "")), "before the summary");
+});
+
+test("the continuation header uses the invoice's own company, number, date and customer", () => {
+  const api = load();
+  const head = api.continuationHeadHtml(invoice());
+  for (const text of ["Zenith Carrelage", "INVOICE — CONTINUED", "INV-000042", "17/10/2026", "Amine Rahmani"]) assert.ok(head.includes(text), text);
+  assert.ok(!head.includes("Hedjazi") && !head.includes("INV-000018"), "no example value is hard-coded");
+  const named = api.continuationHeadHtml(invoice({ secondCustomer: { name: "Builders & Co" }, business: { name: "A <b> Shop", address: "", phone: "", email: "" } }));
+  assert.ok(named.includes("Amine Rahmani / Builders &amp; Co"), "both customer names, escaped");
+  assert.ok(named.includes("A &lt;b&gt; Shop") && !named.includes("<b>"), "the company name is escaped");
+  assert.ok(api.continuationHeadHtml(invoice({ customer: { name: "", phone: "", address: "" } })).includes("Walk-in"), "a sale without a customer reads as the walk-in customer");
+});
+
+test("French: continuation header and wording follow the language", () => {
+  const api = load("fr");
+  assert.ok(api.continuationHeadHtml(invoice()).includes("FACTURE — SUITE"));
+  const list = api.printItems(invoice({ payments: [{ amount: 1, timestamp: "2026-10-17T14:00:00.000Z" }] }));
+  assert.match(list[3].build(list[3].entries, true), /\(suite\)/);
+});
+
+test("delivery history is a flowing section with its status label as the lead", () => {
+  const api = load();
+  const inv = invoice({
+    items: [item(1, { deliveredNow: 0 }), item(2, { deliveredNow: 2 })],
+    deliveries: [{ type: "sale", date: "2026-10-17T13:32:00.000Z", note: "", lines: [{ lineId: "l2", qty: 2 }] }],
+  });
+  const list = api.printItems(inv);
+  const delivery = list.find((x) => x.kind === "flow" && /DELIVERY HISTORY/.test(x.build(x.entries, false)));
+  assert.ok(delivery, "a partly delivered invoice has a delivery history section");
+  assert.match(delivery.lead, /inv-delivery-status/);
+  assert.equal(delivery.entries.length, 1);
+});
diff --git a/tests/invoice-print.test.js b/tests/invoice-print.test.js
new file mode 100644
index 0000000..1edecd7
--- /dev/null
+++ b/tests/invoice-print.test.js
@@ -0,0 +1,124 @@
+"use strict";
+
+// The rules that lay a printed invoice out over pages (java script/invoice-print.js). layout() is pure: it only needs a
+// function saying whether some markup fits on a page, so a fake page of a fixed height (each fragment has a height) stands in
+// for the browser here. The real thing, in Chrome, is checked by tests/e2e/invoice_pagination_check.py.
+
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const vm = require("node:vm");
+
+const context = { globalThis: null };
+context.globalThis = context;
+vm.createContext(context);
+vm.runInContext(fs.readFileSync(path.join(__dirname, "..", "java script", "invoice-print.js"), "utf8"), context, { filename: "invoice-print.js" });
+// The script runs in its own vm context, so the arrays it returns come from another realm; copy them so deepEqual compares them.
+const layout = (items, fits) => JSON.parse(JSON.stringify(context.InvoicePrint.layout(items, fits)));
+
+// A fragment is written "name:height". A built piece such as "[head:5|row1:5,row2:5]" is as tall as everything inside it (every
+// ":N" counts: 5 + 5 + 5). A page holds PAGE units; a continuation header (pages 2 and up) takes HEAD of them.
+const PAGE = 100;
+const HEAD = 10;
+const height = (fragment) => [...String(fragment).matchAll(/:(\d+)/g)].reduce((sum, m) => sum + Number(m[1]), 0);
+const fits = (fragments, pageIndex) => (pageIndex > 0 ? HEAD : 0) + fragments.reduce((sum, f) => sum + height(f), 0) <= PAGE;
+
+const rows = (n, h) => Array.from({ length: n }, (_, i) => `row${i + 1}:${h}`);
+const table = (entries) => `[head:5|${entries.join(",")}]`;                       // the heading repeats in every piece
+const section = (title) => (entries, continued) => `<${continued ? title + "(cont)" : title}:6|${entries.join(",")}>`;
+const flow = (entries, build, lead) => ({ kind: "flow", lead: lead || "", entries, build });
+const block = (name, h) => ({ kind: "block", html: `${name}:${h}` });
+
+// What a piece of markup holds, for the checks: the entries inside [..] or <..>.
+const entriesIn = (page) => page.flatMap((f) => (f.match(/row\d+|pay\d+/g) || []));
+const pageHeight = (page, index) => (index > 0 ? HEAD : 0) + page.reduce((sum, f) => sum + height(f), 0);
+
+test("a short invoice is one page, in order", () => {
+  const pages = layout([block("head", 20), flow(rows(3, 5), table), block("summary", 20), block("thanks", 5)], fits);
+  assert.equal(pages.length, 1);
+  assert.equal(pages[0][0], "head:20");
+  assert.equal(pages[0].at(-1), "thanks:5");
+});
+
+test("product rows continue on the next page, each exactly once and in order, and every piece repeats the heading", () => {
+  const pages = layout([block("head", 20), flow(rows(30, 5), table), block("summary", 20)], fits);
+  assert.ok(pages.length >= 3);
+  assert.deepEqual(pages.flatMap(entriesIn).filter((x) => x.startsWith("row")), rows(30, 5).map((r) => r.split(":")[0]));
+  for (const page of pages.slice(0, -1)) assert.ok(page.some((f) => f.startsWith("[head:5|")), "a page of products shows the heading");
+  pages.forEach((page, i) => assert.ok(pageHeight(page, i) <= PAGE, `page ${i + 1} is within the page`));
+});
+
+test("the financial summary is never split: it stays under the products when it fits and moves whole when it does not", () => {
+  for (let n = 1; n <= 40; n++) {
+    const pages = layout([block("head", 20), flow(rows(n, 5), table), block("summary", 30), block("thanks", 5)], fits);
+    const holding = pages.map((p, i) => (p.includes("summary:30") ? i : -1)).filter((i) => i >= 0);
+    assert.equal(holding.length, 1, `${n} rows: the summary appears once`);
+    const lastRows = Math.max(...pages.map((p, i) => (entriesIn(p).length ? i : -1)));
+    const onSamePage = pages[lastRows].includes("summary:30");
+    const wouldFit = fits(pages[lastRows].concat("summary:30"), lastRows);
+    if (!onSamePage) assert.equal(wouldFit, false, `${n} rows: the summary only moves to a new page when it does not fit under the products`);
+  }
+});
+
+test("the summary is not forced onto a new page when there is room", () => {
+  const pages = layout([block("head", 20), flow(rows(4, 5), table), block("summary", 30)], fits);
+  assert.equal(pages.length, 1);
+});
+
+test("payment history: its heading never sits alone at the bottom of a page, and its entries flow over pages", () => {
+  const pay = Array.from({ length: 60 }, (_, i) => `pay${i + 1}:4`);
+  for (let n = 1; n <= 20; n++) {
+    const pages = layout([block("head", 20), flow(rows(n, 5), table), block("summary", 30), flow(pay, section("HISTORY"))], fits);
+    assert.deepEqual(pages.flatMap(entriesIn).filter((x) => x.startsWith("pay")), pay.map((p) => p.split(":")[0]), `${n} rows: each payment once, in order`);
+    pages.forEach((page, i) => {
+      assert.ok(pageHeight(page, i) <= PAGE, `${n} rows: page ${i + 1} is within the page`);
+      const last = page.at(-1);
+      if (last.startsWith("<")) assert.ok(/pay\d+/.test(last), `${n} rows: a history piece always holds at least one payment`);
+    });
+    const firstPiece = pages.flat().findIndex((f) => f.startsWith("<HISTORY:"));
+    assert.ok(firstPiece >= 0 && /pay1\b/.test(pages.flat()[firstPiece]), `${n} rows: the heading is with the first payment`);
+    assert.equal(pages.flat().filter((f) => f.startsWith("<HISTORY(cont)")).length > 0, pages.flat().filter((f) => f.startsWith("<HISTORY")).length > 1);
+  }
+});
+
+test("the lead of a section (the delivery status) stays with the section's first piece", () => {
+  for (let n = 1; n <= 25; n++) {
+    const pages = layout([flow(rows(n, 5), table), block("summary", 30), flow(["pay1:4", "pay2:4"], section("DELIVERY"), "status:8")], fits);
+    const flat = pages.map((p) => p.slice());
+    const at = flat.findIndex((p) => p.includes("status:8"));
+    assert.ok(at >= 0, `${n} rows: the status is there`);
+    assert.ok(flat[at].some((f) => f.startsWith("<DELIVERY:")), `${n} rows: the status is on the same page as the delivery heading`);
+    assert.ok(flat[at].indexOf("status:8") < flat[at].findIndex((f) => f.startsWith("<DELIVERY:")), `${n} rows: the status comes first`);
+  }
+});
+
+test("a section with no entries (nothing to list) still prints its heading and stays together", () => {
+  const pages = layout([flow(rows(2, 5), table), block("summary", 30), flow([], (entries) => `<EMPTY:6|${entries.join(",")}>`)], fits);
+  assert.equal(pages.length, 1);
+  assert.ok(pages[0].includes("<EMPTY:6|>"));
+});
+
+test("the thank-you follows the last section and gets a page of its own only when it does not fit", () => {
+  const fitting = layout([flow(rows(3, 5), table), block("summary", 30), flow(["pay1:4"], section("HISTORY")), block("thanks", 10)], fits);
+  assert.equal(fitting.length, 1);
+  assert.equal(fitting[0].at(-1), "thanks:10");
+  const tight = layout([flow(rows(3, 5), table), block("summary", 30), flow(["pay1:4"], section("HISTORY")), block("thanks", 40)], fits);
+  assert.equal(tight.length, 1);
+  const over = layout([flow(rows(3, 5), table), block("summary", 30), flow(["pay1:4"], section("HISTORY")), block("thanks", 60)], fits);
+  assert.equal(over.length, 2);
+  assert.equal(over[1].join(), "thanks:60");
+});
+
+test("something taller than a page is still printed (alone on its page) instead of looping or vanishing", () => {
+  const pages = layout([block("head", 20), block("huge", 250), flow(rows(2, 5), table)], fits);
+  assert.ok(pages.some((p) => p.includes("huge:250")));
+  assert.deepEqual(pages.flatMap(entriesIn), ["row1", "row2"]);
+});
+
+test("no page is ever empty", () => {
+  for (let n = 0; n <= 60; n++) {
+    const pages = layout([block("head", 25), flow(rows(n, 7), table), block("summary", 33), flow(Array.from({ length: n % 9 }, (_, i) => `pay${i}:4`), section("HISTORY")), block("thanks", 9)], fits);
+    for (const page of pages) assert.ok(page.length > 0, `${n} rows`);
+  }
+});
