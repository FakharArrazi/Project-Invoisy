+      const pay = V.paymentDetail(invoice, transfers);
+      if (pay.remaining > EPS) {
+        rows.push({ invoice, due: pay.due, paid: pay.paid, transferred: pay.transferredOut, available: pay.remaining });
+      }
+    }
